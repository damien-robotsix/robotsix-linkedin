# robotsix-linkedin — example configuration
#
# Copy to `.env` and fill in real values. NEVER commit a populated `.env`
# (it is git-ignored). All variables use the LINKEDIN_ prefix.

# --- LinkedIn OAuth 2.0 app credentials (required for auth) ---
# Obtain these from https://www.linkedin.com/developers/apps after
# registering an app and requesting the scopes below.
LINKEDIN_CLIENT_ID=your-client-id
LINKEDIN_CLIENT_SECRET=your-client-secret

# Redirect URI registered on the LinkedIn app. Must match exactly.
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/callback

# Optional: extra redirect URIs permitted by the OAuth flow, in addition
# to LINKEDIN_REDIRECT_URI. Space- or comma-separated. Leave empty to
# allow only LINKEDIN_REDIRECT_URI.
LINKEDIN_ALLOWED_REDIRECT_URIS=

# OAuth scopes requested on the consent screen.
#   openid profile email  -> resolve the member URN (Sign In with LinkedIn)
#   w_member_social        -> publish posts on the member's behalf
LINKEDIN_SCOPES=openid profile email w_member_social

# --- Service bind address ---
LINKEDIN_HOST=0.0.0.0
LINKEDIN_PORT=8000

# --- Safety ---
# When True, write endpoints require an operator confirmation token.
LINKEDIN_REQUIRE_OPERATOR_CONFIRMATION=True
